{
  "name": "codeviewer-backend",
  "version": "0.1.0",
  "description": "Bun + Fastify backend for codebase analysis",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "migrate": "bun src/database/migrate.js",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "test": "bun test"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/multipart": "^8.0.0",
    "fastify": "^4.24.3",
    "glob": "^10.3.10",
    "mime-types": "^2.1.35",
    "pino-pretty": "^13.1.1",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "bun-types": "latest"
  }
}
